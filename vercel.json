{
  "version": 2,
  "installCommand": "npm run install-all",
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node"
    },
    {
      "src": "client/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index.js"
    },
    {
      "src": "^/$",
      "dest": "/client/index.html"
    },
    {
      "src": "^/admin/?$",
      "dest": "/client/admin.html"
    },
    {
      "src": "^/admin\\.html$",
      "dest": "/client/admin.html"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/client/$1"
    }
  ]
}
